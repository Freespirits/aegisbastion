# --- Backend services (server-side only; never exposed to the browser) ---
# gatekeeper admin REST + JWKS (doc 11; services/gatekeeper, compose :8080)
GATEKEEPER_URL=http://localhost:8080
# platform-core Mission API REST (doc 01 §7.3; services/platform-core, compose :8081)
PLATFORM_CORE_URL=http://localhost:8081
# data-platform Ingest/GraphQL Query API (doc 09; services/data-platform, compose :8082)
DATA_PLATFORM_URL=http://localhost:8082
# herald control API (doc 05 §4.1; alert-rules UI is a client only — Ruling C7)
HERALD_URL=http://localhost:8086

# --- Session ---
# REQUIRED in anything beyond local dev. >= 32 random bytes.
SESSION_SECRET=dev-only-insecure-session-secret-change-me
# Cookie name override (optional)
# SESSION_COOKIE=aegisbastion_session

# --- Tenancy defaults ---
# Org the dashboard operates against at MVP-A (single tenant cohort, doc 00 §4).
DASHBOARD_ORG_ID=org_acme
# Optional fixed data-platform tenant id sent as X-DP-Tenant; when unset the
# principal's single grant binds implicitly (doc 09 TPEL).
# DASHBOARD_TENANT_ID=

# --- OIDC (production authn; doc 10 §5) ---
# When OIDC_ISSUER is set, /login offers SSO and the dev shim should be off.
# OIDC_ISSUER=https://idp.example.com/realms/aegisbastion
# OIDC_CLIENT_ID=aegisbastion-dashboard
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email

# --- Dev static-token shim (doc 10 MVP: "dev mode static-token shim behind a flag") ---
# Enables POST /api/auth/dev-login and the dev login form. NEVER set in prod.
DEV_AUTH_ENABLED=true
# Shared secret the dev form must present (empty = any principal allowed).
DEV_AUTH_TOKEN=dev-token
# Roles granted to dev sessions when gatekeeper rbac-service is unreachable
# (comma-separated gatekeeper roles; rbac-service grants win when reachable).
DEV_AUTH_FALLBACK_ROLES=operator

# --- Step-up (WebAuthn placeholder flow, doc 10 §7.2) ---
# Step-up assertion lifetime in seconds (doc 10 §7.2: re-auth ≤ 5 min old).
STEPUP_TTL_SECONDS=300

# --- Misc ---
PORT=3000
