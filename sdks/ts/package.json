{
  "name": "@aegisbastion/agent-sdk",
  "version": "0.1.0",
  "description": "AegisBastion platform agent SDK + gatekeeper PEP-SDK (merged per Ruling B): bus transport, registry StreamTasks client, Scope Token verification, scope/manifest guardrails, rate caps, revocation/kill handling, re-authorization, audit helpers, MinIO manifest fetch.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
