# AegisBastion MVP-A local-dev defaults. Copy to .env and override as needed.
# These are development-only credentials — never reuse them anywhere real.

# Postgres 16 (single DB `aegisbastion`, schema-per-bounded-context)
POSTGRES_USER=aegisbastion
POSTGRES_PASSWORD=aegisbastion-dev
POSTGRES_DB=aegisbastion
POSTGRES_PORT=5432

# NATS JetStream
NATS_PORT=4222
NATS_MON_PORT=8222

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=aegisbastion
MINIO_ROOT_PASSWORD=aegisbastion-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# App tier ports
GATEKEEPER_GRPC_PORT=50051
GATEKEEPER_HTTP_PORT=8080
PLATFORM_REST_PORT=8081
PLATFORM_GRPC_PORT=50052
DP_HTTP_PORT=8082
DISCOVER_HTTP_PORT=8083
MONITOR_HTTP_PORT=8084
DETECT_HTTP_PORT=8085
ALERT_HTTP_PORT=8086
DASHBOARD_PORT=3000

# Alert channel credentials (empty = channel disabled)
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_SIGNING_SECRET=

# Dashboard OIDC (empty = login disabled until wired)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# Dashboard session (required — generate: openssl rand -hex 32)
SESSION_SECRET=
# Dev-only static-token login shim (never enable outside local dev)
DEV_AUTH_ENABLED=true

# Herald admin principals allowed to mutate routing/escalation policies
# (dashboard forwards the logged-in identity as X-AegisBastion-Actor)
HERALD_ADMIN_ACTORS=cai,hexstrike-ai
